{
  "manifest_version": 3,
  "name": "MephistoMail",
  "version": "1.0.1",
  "description": "Temporary email with privacy-first browser tools.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open MephistoMail"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "clipboardWrite",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.guerrillamail.com/*",
    "https://api.mail.tm/*",
    "https://api.mail.gw/*"
  ]
}
